
# --- LiveKit connection (required, agent needs these to connect to your LiveKit project) ---
LIVEKIT_URL= 
LIVEKIT_API_KEY= 
LIVEKIT_API_SECRET= 

# --- STT (Deepgram) ---
DEEPGRAM_API_KEY= 

# --- TTS (Cartesia) ---
CARTESIA_API_KEY= 

# --- MT (translation) ---
# Fallback: DeepL. Leave blank to skip DeepL and fall back straight to Google.
DEEPL_API_KEY= 

# Primary: Google Cloud Translate (simple API key auth, as used by mt_node.py)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

#  Google oAuth
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 